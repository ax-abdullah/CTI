# --- HTTP API ---
PORT=3000
# API key required in X-API-Key header for /v1/* endpoints
API_KEY=change-me

# --- Tenant (single-tenant for Phase 1; registry moves to PostgreSQL in Phase 2) ---
TENANT_ID=lab

# --- PBX (AMI) ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=cti
AMI_SECRET=change-me
# Regex matching internal extensions of this tenant (drives direction detection)
EXTENSION_PATTERN=^1\d{3}$
# Dialplan context used for click-to-call originates
ORIGINATE_CONTEXT=tenant-a-internal
# Channel template for the agent leg. Production FreePBX: PJSIP/{ext}
# Lab (no registered phones): Local/{ext}@tenant-a-internal
ORIGINATE_CHANNEL_TEMPLATE=PJSIP/{ext}

# --- Webhooks (generic CRM integration) ---
WEBHOOK_URL=http://127.0.0.1:4000/cti-events
WEBHOOK_SECRET=change-me

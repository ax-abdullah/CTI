# --- HTTP API ---
PORT=3000
# Public base URL of this platform (used to build signed recording links)
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- Infrastructure ---
DATABASE_URL=postgres://cti:cti-dev@127.0.0.1:5433/cti
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# --- Secrets ---
# 32-byte hex master key for credential encryption (AES-256-GCM)
CREDS_KEY=change-me-64-hex-chars
# Softphone agent session tokens (HS256)
SOFTPHONE_JWT_SECRET=change-me
# Signs short-lived recording URLs
RECORDINGS_URL_SECRET=change-me
# Platform-operator key for /admin
ADMIN_API_KEY=change-me

# --- Recordings ---
# Directory the recording proxy serves from (lab: bind mount of the
# Asterisk monitor dir; production: recordings share/sync)
RECORDINGS_BASE_DIR=/path/to/recordings

# --- Seed (lab bootstrap only; admin API replaces this for real tenants) ---
SEED_AMI_HOST=127.0.0.1
SEED_AMI_PORT=5038
SEED_AMI_USERNAME=cti
SEED_AMI_SECRET=change-me
# direct = cloud dials the PBX; reverse = on-prem connector agent dials out
SEED_PBX_MODE=direct

# Originate rate limit (per tenant / per agent session)
ORIGINATE_RATE_LIMIT=30
ORIGINATE_RATE_TTL_SEC=60

# Logging: json (default, structured) or pretty (coloured, for local dev)
LOG_FORMAT=json

# WebRTC softphone (Phase 10): the PBX WebSocket transport + SIP domain
WEBRTC_WSS_URL=wss://pbx.example.com:8089/ws
WEBRTC_SIP_DOMAIN=pbx.example.com
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# --- Cluster (Phase 12a) — only needed when running more than one replica ---
# Identity used for ownership leases. Defaults to hostname + a random suffix,
# which is right in Kubernetes (the hostname is the pod name). The suffix
# distinguishes a restarted pod from its predecessor so a stale lease is never
# mistaken for self-owned. Override only if you know why.
# POD_ID=cti-replica-1

# How long a crashed replica's PBX connections stay orphaned before a peer
# claims them. Lower = faster failover, more Redis traffic.
LEASE_TTL_MS=30000

# Lease renewal cadence — must stay comfortably below LEASE_TTL_MS.
LEASE_RENEW_MS=10000

# Cross-replica command timeout (click-to-call/coaching routed to the pod that
# owns the PBX socket). Deliberately longer than the 10s AMI action timeout so
# the PBX's own error text wins instead of a generic "no reply".
CLUSTER_RPC_TIMEOUT_MS=15000

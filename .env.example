# --- HTTP API ---
PORT=3000
# Public base URL of this platform (used to build signed recording links)
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- Infrastructure ---
DATABASE_URL=postgres://cti:cti-dev@127.0.0.1:5433/cti
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# --- Secrets ---
# 32-byte hex master key for credential encryption (AES-256-GCM)
CREDS_KEY=change-me-64-hex-chars
# Softphone agent session tokens (HS256)
SOFTPHONE_JWT_SECRET=change-me
# Signs short-lived recording URLs
RECORDINGS_URL_SECRET=change-me
# Platform-operator key for /admin
ADMIN_API_KEY=change-me

# --- Recordings ---
# Directory the recording proxy serves from (lab: bind mount of the
# Asterisk monitor dir; production: recordings share/sync)
RECORDINGS_BASE_DIR=/path/to/recordings

# --- Seed (lab bootstrap only; admin API replaces this for real tenants) ---
SEED_AMI_HOST=127.0.0.1
SEED_AMI_PORT=5038
SEED_AMI_USERNAME=cti
SEED_AMI_SECRET=change-me
# direct = cloud dials the PBX; reverse = on-prem connector agent dials out
SEED_PBX_MODE=direct

# Originate rate limit (per tenant / per agent session)
ORIGINATE_RATE_LIMIT=30
ORIGINATE_RATE_TTL_SEC=60

# Logging: json (default, structured) or pretty (coloured, for local dev)
LOG_FORMAT=json

{
  "info": {
    "name": "CTI Platform",
    "description": "Multi-tenant CTI middleware (Asterisk/FreePBX <-> CRM): click-to-call, screen pops, automated call logging, presence, recordings, admin.\n\nSet the collection variables before use. Auth realms:\n- Tenant API: X-API-Key (issued once at tenant creation)\n- Softphone: Bearer agent token (from /v1/softphone/login)\n- Zoho callback: X-Zoho-Token (per-integration callback token)\n- Admin: X-Admin-Key (ADMIN_API_KEY env)\n\nWebSocket channels (use a WS client, not HTTP): {{baseUrl}}/softphone-ws?token=<agentToken> and {{baseUrl}}/connector-ws?token=<connectorToken>.\n\nWebhooks OUT are signed: X-CTI-Timestamp (epoch ms) + X-CTI-Signature = hex HMAC-SHA256(secret, `${timestamp}.${rawBody}`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "tenantApiKey", "value": "tenant-a-REPLACE" },
    { "key": "adminApiKey", "value": "admin-REPLACE" },
    { "key": "agentToken", "value": "REPLACE-from-softphone-login" },
    { "key": "zohoCallbackToken", "value": "zoho-callback-token-a" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health / PBX connection state",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "No auth. status is `ok` when every PBX connection is up, `degraded` otherwise."
          },
          "response": [
            {
              "name": "All connections up",
              "originalRequest": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\",\n  \"connections\": [\n    {\n      \"connectionId\": \"df6f80a8-d305-47dd-bbe5-0f35a4d05308\",\n      \"name\": \"lab-asterisk\",\n      \"mode\": \"reverse\",\n      \"connected\": true\n    }\n  ]\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Tenant API",
      "item": [
        {
          "name": "Click-to-call (originate)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{tenantApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"agentExt\": \"1001\",\n  \"number\": \"+966501234567\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/calls/originate", "host": ["{{baseUrl}}"], "path": ["v1", "calls", "originate"] },
            "description": "Agent-leg-first: the agent's phone rings, then the PBX dials the number. The callRef reappears on the resulting call.* events."
          },
          "response": [
            {
              "name": "Originating",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/calls/originate", "host": ["{{baseUrl}}"], "path": ["v1", "calls", "originate"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"originating\",\n  \"callRef\": \"c0e89bce-3c1b-4bea-9bc2-8e1acc6a997d\",\n  \"agentExt\": \"1001\",\n  \"number\": \"+966501234567\"\n}"
            },
            {
              "name": "Invalid API key",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/calls/originate", "host": ["{{baseUrl}}"], "path": ["v1", "calls", "originate"] } },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Invalid API key\",\n  \"error\": \"Unauthorized\",\n  \"statusCode\": 401\n}"
            }
          ]
        },
        {
          "name": "Active calls snapshot",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{tenantApiKey}}" }],
            "url": { "raw": "{{baseUrl}}/v1/calls", "host": ["{{baseUrl}}"], "path": ["v1", "calls"] }
          },
          "response": [
            {
              "name": "One live call",
              "originalRequest": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/calls", "host": ["{{baseUrl}}"], "path": ["v1", "calls"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"calls\": [\n    {\n      \"callId\": \"1784468433.4\",\n      \"direction\": \"outbound\",\n      \"agentExt\": \"1000\",\n      \"remoteNumber\": null,\n      \"state\": \"answered\",\n      \"startedAt\": \"2026-07-19T13:40:33.489Z\",\n      \"channels\": [\"Local/1000@tenant-a-internal-00000001;1\", \"Local/1000@tenant-a-internal-00000001;2\"]\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Agent presence snapshot",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{tenantApiKey}}" }],
            "url": { "raw": "{{baseUrl}}/v1/agents/state", "host": ["{{baseUrl}}"], "path": ["v1", "agents", "state"] },
            "description": "States: NOT_INUSE | RINGING | INUSE (from call lifecycle) | UNAVAILABLE (device unregistered)."
          },
          "response": [
            {
              "name": "Snapshot",
              "originalRequest": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/agents/state", "host": ["{{baseUrl}}"], "path": ["v1", "agents", "state"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"agents\": [\n    { \"tenantId\": \"tenant-a\", \"ext\": \"1001\", \"state\": \"NOT_INUSE\", \"at\": \"2026-07-20T23:11:30.775Z\" }\n  ]\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Softphone",
      "item": [
        {
          "name": "Agent login (issue session token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{tenantApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"ext\": \"1001\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/softphone/login", "host": ["{{baseUrl}}"], "path": ["v1", "softphone", "login"] },
            "description": "Save the token into {{agentToken}}. Also used on the WebSocket: {{baseUrl}}/softphone-ws?token=<token>."
          },
          "response": [
            {
              "name": "Token issued",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/softphone/login", "host": ["{{baseUrl}}"], "path": ["v1", "softphone", "login"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0ZW5hbnRTbHVnIjoidGVuYW50LWEiLCJleHQiOiIxMDAxIiwiZXhwIjoxNzg0NjExNDAwfQ.rmNp-IXCC...\",\n  \"ext\": \"1001\",\n  \"displayName\": \"A Agent 1001\",\n  \"expiresInSec\": 28800\n}"
            }
          ]
        },
        {
          "name": "Click-to-dial (as agent)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{agentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"number\": \"+966501234567\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/softphone/originate", "host": ["{{baseUrl}}"], "path": ["v1", "softphone", "originate"] },
            "description": "What the softphone page (or Salesforce onClickToDial) calls. The agent is identified by the token."
          },
          "response": [
            {
              "name": "Originating",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/softphone/originate", "host": ["{{baseUrl}}"], "path": ["v1", "softphone", "originate"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"originating\",\n  \"callRef\": \"1a6df105-32ef-4914-b4a6-b25e67a9d6de\",\n  \"agentExt\": \"1001\",\n  \"number\": \"+966501234567\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Zoho integration",
      "item": [
        {
          "name": "Click-to-call callback (from Zoho)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Zoho-Token", "value": "{{zohoCallbackToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"zohoUserId\": \"zuid-1001\",\n  \"number\": \"+966501234567\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/v1/integrations/zoho/tenant-a/click-to-call",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "integrations", "zoho", "tenant-a", "click-to-call"]
            },
            "description": "Registered as the PhoneBridge click-to-call URL. Maps the Zoho user to an agent extension via Agent.crmRefs.zoho."
          },
          "response": [
            {
              "name": "Originating",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/integrations/zoho/tenant-a/click-to-call", "host": ["{{baseUrl}}"], "path": ["v1", "integrations", "zoho", "tenant-a", "click-to-call"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"originating\",\n  \"callRef\": \"0dcd4c85-43f0-4704-b79b-7e5424f63d4a\",\n  \"agentExt\": \"1001\",\n  \"number\": \"+966501234567\"\n}"
            },
            {
              "name": "Unmapped Zoho user",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/v1/integrations/zoho/tenant-a/click-to-call", "host": ["{{baseUrl}}"], "path": ["v1", "integrations", "zoho", "tenant-a", "click-to-call"] } },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Zoho user zuid-9999 is not mapped to an agent\",\n  \"error\": \"Bad Request\",\n  \"statusCode\": 400\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Recordings",
      "item": [
        {
          "name": "Fetch recording (signed capability URL)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/recordings/eyJmIjoiMTc4NDU4OTA4OC4wLndhdiIsImV4cCI6MTc4NDU4OTk5MH0.aSfdkv0ydzf__gaQSBljZ-0hBTqaSS3YpalbhaJft7E",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "recordings", "eyJmIjoiMTc4NDU4OTA4OC4wLndhdiIsImV4cCI6MTc4NDU4OTk5MH0.aSfdkv0ydzf__gaQSBljZ-0hBTqaSS3YpalbhaJft7E"]
            },
            "description": "Use the recordingUrl from a call.ended event verbatim — the token IS the auth (15-min expiry). Returns audio/wav; expired or tampered tokens return 404."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Admin-Key", "value": "{{adminApiKey}}" }],
            "url": { "raw": "{{baseUrl}}/admin/overview", "host": ["{{baseUrl}}"], "path": ["admin", "overview"] }
          },
          "response": [
            {
              "name": "Overview",
              "originalRequest": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/overview", "host": ["{{baseUrl}}"], "path": ["admin", "overview"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"connections\": [\n    { \"connectionId\": \"df6f80a8-d305-47dd-bbe5-0f35a4d05308\", \"name\": \"lab-asterisk\", \"mode\": \"reverse\", \"connected\": true }\n  ],\n  \"tenants\": [\n    { \"slug\": \"tenant-a\", \"name\": \"Tenant A (lab)\", \"agents\": 2, \"webhookUrl\": \"http://127.0.0.1:4000/cti-events\", \"integrations\": [\"zoho\"] },\n    { \"slug\": \"tenant-b\", \"name\": \"Tenant B (lab)\", \"agents\": 2, \"webhookUrl\": \"http://127.0.0.1:4001/cti-events\", \"integrations\": [\"salesforce\"] }\n  ],\n  \"activeCalls\": [],\n  \"queues\": {\n    \"webhook\": { \"active\": 0, \"completed\": 3, \"failed\": 0, \"waiting\": 0 },\n    \"zoho\": { \"active\": 0, \"completed\": 3, \"failed\": 0, \"waiting\": 0 },\n    \"salesforce\": { \"active\": 0, \"completed\": 1, \"failed\": 0, \"waiting\": 0 }\n  }\n}"
            }
          ]
        },
        {
          "name": "Hot-reload registry",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Admin-Key", "value": "{{adminApiKey}}" }],
            "url": { "raw": "{{baseUrl}}/admin/reload", "host": ["{{baseUrl}}"], "path": ["admin", "reload"] },
            "description": "Re-reads the DB registry; only changed PBX connections restart (live tunnels survive)."
          },
          "response": [
            {
              "name": "Reloaded",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/admin/reload", "host": ["{{baseUrl}}"], "path": ["admin", "reload"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"reloaded\"\n}"
            }
          ]
        },
        {
          "name": "Create PBX connection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"customer-freepbx\",\n  \"mode\": \"reverse\",\n  \"host\": \"127.0.0.1\",\n  \"port\": 5038,\n  \"username\": \"cti\",\n  \"secret\": \"ami-manager-secret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/pbx-connections", "host": ["{{baseUrl}}"], "path": ["admin", "pbx-connections"] },
            "description": "mode reverse: host/port are the AMI address as seen by the on-prem agent; the connectorToken in the response is shown exactly once."
          },
          "response": [
            {
              "name": "Created (reverse)",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/admin/pbx-connections", "host": ["{{baseUrl}}"], "path": ["admin", "pbx-connections"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"9c1a7a44-2f3b-4a56-8f0e-2d9d1a8f7b21\",\n  \"name\": \"customer-freepbx\",\n  \"mode\": \"reverse\",\n  \"connectorToken\": \"conn-e4b2af9a16bd62918eb7382331ac217f96f0d276d84934c8\"\n}"
            }
          ]
        },
        {
          "name": "Create tenant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"acme\",\n  \"name\": \"Acme Corp\",\n  \"pbxConnectionId\": \"9c1a7a44-2f3b-4a56-8f0e-2d9d1a8f7b21\",\n  \"extensionPattern\": \"^1\\\\d{3}$\",\n  \"contexts\": [\"from-internal\"],\n  \"originateContext\": \"from-internal\",\n  \"originateChannelTemplate\": \"PJSIP/{ext}\",\n  \"webhookUrl\": \"https://crm.acme.com/cti-events\",\n  \"webhookSecret\": \"acme-webhook-secret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/tenants", "host": ["{{baseUrl}}"], "path": ["admin", "tenants"] },
            "description": "The apiKey in the response is shown exactly once (stored as sha256)."
          },
          "response": [
            {
              "name": "Created",
              "originalRequest": { "method": "POST", "url": { "raw": "{{baseUrl}}/admin/tenants", "host": ["{{baseUrl}}"], "path": ["admin", "tenants"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"5b8e5f2a-6f1c-4f3e-9f6a-1a2b3c4d5e6f\",\n  \"slug\": \"acme\",\n  \"apiKey\": \"acme-8870cec891485d9d0710829c611af927448390dd3b936de2\"\n}"
            }
          ]
        },
        {
          "name": "Create agent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantSlug\": \"acme\",\n  \"ext\": \"1001\",\n  \"displayName\": \"Sara Al-Harbi\",\n  \"crmRefs\": { \"zoho\": \"zuid-1001\", \"salesforce\": \"005XXXXXXXXXXXX\" }\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/agents", "host": ["{{baseUrl}}"], "path": ["admin", "agents"] }
          },
          "response": []
        },
        {
          "name": "Create CRM integration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Admin-Key", "value": "{{adminApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantSlug\": \"acme\",\n  \"type\": \"zoho\",\n  \"config\": {\n    \"dc\": \"sa\",\n    \"accountsBaseUrl\": \"https://accounts.zoho.sa\",\n    \"apiBaseUrl\": \"https://phonebridge.zoho.sa/phonebridge/v3\",\n    \"clientId\": \"1000.XXXX\"\n  },\n  \"secrets\": {\n    \"clientSecret\": \"...\",\n    \"refreshToken\": \"...\",\n    \"callbackToken\": \"...\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/integrations", "host": ["{{baseUrl}}"], "path": ["admin", "integrations"] },
            "description": "config is non-secret; secrets are stored AES-256-GCM encrypted. Run /admin/reload afterwards."
          },
          "response": []
        }
      ]
    }
  ]
}
